@model Biblio.Models.Autor

<h1>Eliminar autor</h1>

<div class="alert alert-danger">
    ¿Está seguro de que desea eliminar este autor?
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Lastname</dd>

    <dt class="col-sm-3">País</dt>
    <dd class="col-sm-9">@Model.Country</dd>

    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.Birthdate</dd>
</dl>

<form asp-action="DeleteAutorConfirmed" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>