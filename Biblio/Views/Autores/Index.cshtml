@model ICollection<Autor>
@{
    
}

<h1>@ViewData["Title"]</h1>


<a asp-action="Create" class="btn btn-primary">Crear Autor</a>

<div class="row">
    @foreach(var autor in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@autor.Name</h5>
                    <h5>@autor.Lastname</h5>
                    <h6>@autor.Country</h6>
                    <p>Edad : @(DateTime.UtcNow.Year - autor.Birthdate.Year)</p>
                    <a class ="btn btn-info" asp-action="Details" asp-route-id="@autor.Id">Ver</a>
                    <a class="btn btn-secondary" asp-action="EditView" asp-route-id="@autor.Id">Editar Autor</a>
                    <a class="btn btn-danger" asp-action="DeleteAutor" asp-route-id="@autor.Id">Eliminar Autor</a>
                </div>

            </div>
        </div>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Apellido</th>
        <th>Pais</th>
        <th>Fecha de Nacimiento</th>
        <th>Activo?</th>
        </tr>
    </thead>
    <tbody>

        @foreach(var autor in Model)
        {
            <tr>
                <td>@autor.Id</td>
                <td>@autor.Name</td>
                <td>@autor.Lastname</td>
                <td>@autor.Country</td>
                <td>@autor.Birthdate</td>
                <td>
                @if (autor.IsActive)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Desactivado</span>

                }
                </td>
                        
                
            </tr>
        }



    </tbody>

  
</table>