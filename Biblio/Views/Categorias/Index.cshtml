@model IEnumerable<Categoria>;
@{

    ViewData["Title"] = "Categorías ";

}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Listado de Categorias </h1>
</div>

<a class="btn btn-primary" asp-controller="Categorias" asp-action="Create">Agregar Categoria</a>
<table class="table table-striped">


        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripcion</th>
                <th>Acciones</th>
            </tr>
            <tbody>
            @foreach(var categoria in Model)
            {
                <tr>
                    <td>@categoria.ID</td>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           asp-action="Edit"
                           asp-route-id="@categoria.ID">
                            Editar
                        </a>

                        <a class="btn btn-danger btn-sm"
                           asp-action="Delete"
                           asp-route-id="@categoria.ID"
                           onclick="return confirm('¿Está seguro de eliminar esta categoría?');">
                            Eliminar
                        </a>
                </tr>
            }
        </tbody>

        
</table>

@section Scripts{
    <script>
        var mensaje = '@(TempData["SuccessMessage"] ?? "")';
        if(mensaje){

            Swal.fire({
                icon : "success",
                title : "Exito",
                text : mensaje,
                timer : 2000,
                showConfirmButton : false
            })

        }
    </script>
}