@{
    ViewData["Title"] = "Acerca de";

}
<section class="about-container">

    <header class="about-header">
        <h2>Acerca de nuestra Biblioteca Virtual</h2>

        <p>
            Nuestra Biblioteca Virtual permite consultar información
            sobre libros, autores y diferentes categorías literarias.
        </p>
    </header>

    <section class="about-content">

        @await Html.PartialAsync("_infoCard", new InfoCard()
        {
            Title = "Nuestros Servicios",
            Text = "Consulta libros y autores disponibles en la biblioteca"
        })

        @await Html.PartialAsync("_InfoCard", new InfoCard()
        {
            Title = "Categorias",
            Text = "Encuentra libros organizados por diferentes categorias"
        })

        @await Html.PartialAsync("_InfoCard", new InfoCard()
        {
            Title = "Autores",
            Text = "Conoce informacion sobre los autores registrados"
        })

        @await Html.PartialAsync("_InfoCard", new InfoCard()
        {
            Title = "Libros",
            Text = "Conoce informacion sobre los Libros diisponibles"
        })

    </section>

</section>