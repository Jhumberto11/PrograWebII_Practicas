@{
    ViewData["Title"] = "Acerca de";

}
<section class="about-container">

    <header class="about-header">
        <h2>Acerca de nuestra Biblioteca Virtual</h2>

        <p>
            Nuestra Biblioteca Virtual permite consultar información
            sobre libros, autores y diferentes categorías literarias.
        </p>
    </header>

    <section class="about-content">

        <article class="about-card">
            <h3>Libros y Autores</h3>

            <p>
                Los usuarios pueden consultar los libros registrados
                y conocer información sobre sus respectivos autores.
            </p>
        </article>

        <article class="about-card">
            <h3>Categorías</h3>

            <p>
                Los libros pueden organizarse por categorías como
                literatura, ciencia, historia, tecnología y educación.
            </p>
        </article>

        <article class="about-card">
            <h3>Servicios</h3>

            <p>
                La Biblioteca Virtual facilita la búsqueda y consulta
                de información bibliográfica de manera rápida y sencilla.
            </p>
        </article>

    </section>

</section>