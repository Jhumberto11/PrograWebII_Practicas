@{
    ViewData["Title"] = "Home Page";
}

@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">

    <div class="welcome-info">
        

        <h1>Biblioteca Virtual</h1>

        
        <p>
            Consulta libros y autores disponibles en nuestra biblioteca.
        </p>

        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">
            Ver libros
        </a>
    </div>



    <div class="tarjetas-home">

      
        <div class="card shadow-sm text-center">
            <div class="card-body p-4">
                    <h3 class="card-title">Libros</h3>

                    <p class="card-text">
                        Consulta los libros registrados en la biblioteca.
                    </p>

                    <a asp-controller="Libros"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ver libros
                    </a>   
            </div>
        </div>

        <div class="card shadow-sm text-center">
            <div class="card-body p-4">
                    <h3 class="card-title">Autores</h3>

                    <p class="card-text">
                        Consulta los autores registrados en el sistema.
                    </p>

                    <a asp-controller="Autores"
                       asp-action="Index"
                       class="btn btn-success">
                        Ver autores
                    </a>             
            </div>
        </div>

    </div>

    <section>

        <h2 class="text-center mb-4">
            Nuestros Servicios
        </h2>

        <div class="home-cards">

            @await Html.PartialAsync("_ServiceCard", new ServiceCard()
            {
                Title = "Libros",
                Text = "Consulta los libros registrados en nuestra biblioteca.",
                ImageUrl = "https://images.unsplash.com/photo-1521587760476-6c12a4b040da",
                Id = 1
            })

            @await Html.PartialAsync("_ServiceCard", new ServiceCard()
            {
                Title = "Autores",
                Text = "Consulta información sobre los autores registrados.",
                ImageUrl = "https://images.unsplash.com/photo-1455390582262-044cdead277a",
                Id = 2
            })

        </div>

    </section>


    <section class="mt-5">
        <h2 class="text-center mb-4">Categorías</h2>

        <div class="categorias-grid">

            <div class="categoria">
                <h4>Historia</h4>
                <p>Libros relacionados con acontecimientos históricos.</p>
            </div>

            <div class="categoria">
                <h4>Ciencia</h4>
                <p>Libros sobre ciencia, investigación y tecnología.</p>
            </div>

            <div class="categoria">
                <h4>Literatura</h4>
                <p>Novelas, cuentos y obras literarias.</p>
            </div>

            <div class="categoria">
                <h4>Educación</h4>
                <p>Material relacionado con aprendizaje y estudio.</p>
            </div>

        </div>
    </section>


    <div class="mt-5">
        <partial name="About" />
    </div>

</div>